# FileMaker Data API connection.
# Copy to .env and fill in. Never commit .env.

# Server origin only — no path, no trailing slash. https:// is added if omitted.
FM_SERVER_URL=https://your-server.example.com

# The hosted file name, without the .fmp12 extension.
FM_DATABASE=RMCSS__DEV

# A FileMaker account whose privilege set has the "fmrest" extended privilege
# and create access to abv_RSA, abv_RMC and abv_tx.
FM_API_USERNAME=
FM_API_PASSWORD=
